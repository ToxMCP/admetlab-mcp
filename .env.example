# ADMETlab MCP settings
ADMETLAB_BASE_URL="https://admetlab3.scbdd.com"
ADMETLAB_TIMEOUT_SECONDS=30
ADMETLAB_RETRY_ATTEMPTS=3
ADMETLAB_RETRY_BACKOFF=0.5
ADMETLAB_RPS_LIMIT=5
ADMETLAB_BATCH_SIZE=1000
ADMETLAB_FEATURE_DEFAULT=false
ADMETLAB_UNCERTAIN_DEFAULT=false
ADMETLAB_ADMET_ENDPOINT="/api/admet"
# Accepts comma-separated paths or JSON array, e.g. "/api/single/admet,/api/admet"
# or ["/api/single/admet","/api/admet"]
ADMETLAB_ADMET_FALLBACK_ENDPOINTS="/api/single/admet"
ADMETLAB_API_KEY=""
ADMETLAB_LOG_LEVEL="INFO"
