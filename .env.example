# ADMETlab MCP settings
ADMETLAB_BASE_URL="https://admetlab3.scbdd.com"
ADMETLAB_TIMEOUT_SECONDS=30
ADMETLAB_RETRY_ATTEMPTS=3
ADMETLAB_RETRY_BACKOFF=0.5
ADMETLAB_RPS_LIMIT=5
ADMETLAB_BATCH_SIZE=1000
ADMETLAB_FEATURE_DEFAULT=false
# Deprecated compatibility setting; /api/single/admet does not accept it.
ADMETLAB_UNCERTAIN_DEFAULT=false
ADMETLAB_ADMET_ENDPOINT="/api/single/admet"
# Deprecated compatibility setting. Automatic fallback is disabled because
# prediction endpoints do not share the same request contract.
ADMETLAB_ADMET_FALLBACK_ENDPOINTS=""
ADMETLAB_API_KEY=""
ADMETLAB_LOG_LEVEL="INFO"
